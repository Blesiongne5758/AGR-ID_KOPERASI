# Database Configuration
# Menggunakan Supabase untuk AGR-ID
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Koperasi Lokal (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/koperasi_db

# AGR-ID Configuration
# URL base: https://agr.biz.id (InfinityFree hosting)
AGRID_BASE_URL=https://agr.biz.id
AGRID_API_TOKEN=your_agrid_api_token_here

# GitHub Configuration (untuk sync code jika diperlukan)
# JANGAN COMMIT GITHUB PAT KE REPOSITORY!
# Gunakan environment variables atau secret manager
GITHUB_TOKEN=your_github_pat_here

# Scheduler Configuration
AGRID_SYNC_SCHEDULE=0 2 * * *

# Server Configuration
PORT=3000
NODE_ENV=development
